{
  "name": "vk-mini-app-babkymanki",
  "version": "1.0.0",
  "description": "VK Mini App Babkymanki",
  "scripts": {
    "start:dev": "docker-compose up --build",
    "start:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d",
    "stop": "docker-compose down -v --remove-orphans",
    "dev": "vite",
    "dev:open": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "tunnel": "vk-tunnel --insecure=1 --http-protocol=http --ws-protocol=ws --host=0.0.0.0 --port=5174",
    "deploy": "vk-miniapps-deploy"
  },
  "dependencies": {
    "@vkontakte/vk-bridge": "^2.13.0",
    "axios": "^1.6.7",
    "framer-motion": "^12.23.24",
    "lodash": "^4.17.21",
    "ngrok": "^5.0.0-beta.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^10.0.0",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vkontakte/vk-miniapps-deploy": "^0.0.25",
    "@vkontakte/vk-tunnel": "^0.1.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "vite": "^4.5.2"
  }
}
